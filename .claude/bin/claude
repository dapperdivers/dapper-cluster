#!/usr/bin/env bash
# Wrapper injected via .mise.toml [env]._.path: inside dapper-cluster, plain
# `claude` launches in an isolated git worktree so concurrent sessions don't
# fight over the main checkout's branch state (see CLAUDE.md "Git Workflow").
set -euo pipefail

# Drop this script's directory from PATH so `claude` resolves to the real CLI.
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vFx "$self_dir" | paste -sd:)"

# Hand the session a mise-resolved PATH.
#
# ~/.config/zsh/tools.zsh activates mise in *hook* mode, which rewrites PATH on
# chpwd/precmd — hooks that only fire in interactive shells. Claude inherits
# PATH once at launch and its Bash tool spawns non-interactive shells, so
# without this the agent is stuck with whatever the launching terminal happened
# to have: usually the main checkout's, often months stale.
#
# Prepend `mise bin-paths` (the same install dirs hook-mode activate prepends)
# so the agent gets the versions .mise.toml pins. This is not cosmetic —
# Homebrew independently provides sops, helm, flux, talosctl, flate and
# cloudflared, and without this it silently wins over every one of those pins.
if mise_paths="$(mise bin-paths 2>/dev/null)" && [ -n "$mise_paths" ]; then
  PATH="$(printf '%s' "$mise_paths" | paste -sd:):$PATH"

  # ...but keep an active virtualenv ahead of it. .mise.toml's _.python.venv
  # builds .venv *from* that same interpreter, so the venv is mise's python
  # plus the repo's packages (makejinja, ...); bin-paths would otherwise
  # demote python3 to the bare interpreter.
  [ -n "${VIRTUAL_ENV:-}" ] && [ -d "$VIRTUAL_ENV/bin" ] &&
    PATH="$VIRTUAL_ENV/bin:$PATH"
fi

# Shims LAST as a fallback: bin-paths is resolved here, in the main checkout,
# but the session runs in a worktree whose branch may pin different versions.
# Shims resolve per-CWD and auto-install, so they cover that drift. Ordering
# matters — shims also exist for node/bun/npm/python3, which this repo does not
# pin and Homebrew does provide; a shim with no applicable version *errors*
# rather than falling through, so it must never precede Homebrew. Same
# reasoning as ~/.config/environment.d/10-path.conf.
shims="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims"
[ -d "$shims" ] && PATH="$PATH:$shims"

export PATH

add_worktree=true

# Already inside a linked worktree (git-dir != common-dir): don't nest.
if [ "$(git rev-parse --absolute-git-dir 2>/dev/null)" != "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ]; then
  add_worktree=false
fi

# Subcommands manage the install/config, not a session.
case "${1:-}" in
  mcp|config|update|doctor|install|migrate-installer|setup-token|plugin|agents)
    add_worktree=false ;;
esac

# Flags that resume an existing session or already request a worktree.
for arg in "$@"; do
  case "$arg" in
    -w|--worktree|-c|--continue|-r|--resume|-p|--print|-h|--help|-v|--version)
      add_worktree=false
      break ;;
  esac
done

if ! $add_worktree; then
  exec claude "$@"
elif [ $# -eq 0 ]; then
  exec claude --worktree
else
  # Name the worktree explicitly so a positional prompt isn't eaten as the name.
  exec claude --worktree "wt-$(date +%Y%m%d-%H%M%S)" "$@"
fi
