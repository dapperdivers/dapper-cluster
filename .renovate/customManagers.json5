{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // The standard `# renovate: datasource=<ds> depName=<name>` + `key: value`
  // form is handled by the home-operations base preset. This only covers the
  // variant it doesn't: an annotation followed by a URL with the version in a
  // path segment, e.g.
  //   # renovate: datasource=github-releases depName=dragonflydb/dragonfly-operator
  //   - https://raw.githubusercontent.com/dragonflydb/dragonfly-operator/v1.7.1/manifests/crd.yaml
  customManagers: [
    {
      customType: "regex",
      description: "Process annotated dependencies whose version sits in a URL path",
      managerFilePatterns: ["/(^|/).+\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*-?\\s*https?://\\S+/(?<currentValue>(v|\\d)[^/]+)/",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
    {
      // The barman-cloud plugin takes its sidecar as a full `image:tag` env value,
      // which the annotation preset can't split (it reads up to the last `: `).
      // Untracked, it sat on v0.15.1 while Renovate moved the operator to v0.16.0.
      customType: "regex",
      description: "Track the barman-cloud plugin SIDECAR_IMAGE env value",
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        "SIDECAR_IMAGE:\\s+[\"']?(?<depName>[^:\\s\"']+):(?<currentValue>[^@\\s\"']+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?",
      ],
      datasourceTemplate: "docker",
    },
  ],
}
