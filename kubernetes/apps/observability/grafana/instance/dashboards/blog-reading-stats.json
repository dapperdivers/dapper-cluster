{
  "title": "Blog Reading Stats",
  "uid": "blog-reading-stats",
  "description": "Server-side page views for derekmackley.com/blog: one JSON log line per view from the portfolio server (no IP, no user agent, referrer host only) -> fluent-bit -> VictoriaLogs. VictoriaLogs keeps 14 days.",
  "tags": ["blog", "resume", "logs", "victorialogs"],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Post reads",
      "description": "Views of posts by browsers in the selected range. 304s (a returning reader revalidating) are included.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "refId": "A",
          "queryType": "stats",
          "expr": "app:resume event:=blog_view bot:=false kind:=post | stats count() as views"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "First-time reads",
      "description": "Post views that downloaded the page (200), excluding revalidations by a returning browser.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "refId": "A",
          "queryType": "stats",
          "expr": "app:resume event:=blog_view bot:=false kind:=post repeat:=false | stats count() as views"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Feed fetches",
      "description": "RSS requests. Feed readers identify as bots, so this is fetches, not subscribers.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "refId": "A",
          "queryType": "stats",
          "expr": "app:resume event:=blog_view kind:=feed | stats count() as views"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Bot and crawler hits",
      "description": "Crawlers, link previews and scripts on blog pages. Excluded from the other panels.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "refId": "A",
          "queryType": "stats",
          "expr": "app:resume event:=blog_view bot:=true kind:!=feed | stats count() as views"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Reads per hour",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "refId": "A",
          "queryType": "statsRange",
          "expr": "app:resume event:=blog_view bot:=false | stats by (_time:1h, kind) count() as views",
          "step": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Reads by post",
      "description": "Post slug and browser views in the selected range.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "refId": "A",
          "queryType": "stats",
          "expr": "app:resume event:=blog_view bot:=false kind:=post | stats by (page) count() as views | sort by (views desc)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "views",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Where readers came from",
      "description": "Referring host. direct = no referrer (typed, bookmarked, or the app stripped it). Links between our own pages are excluded.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "refId": "A",
          "queryType": "stats",
          "expr": "app:resume event:=blog_view bot:=false ref:!=internal | stats by (ref) count() as views | sort by (views desc) | limit 25"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "views",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Topic and index views",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "refId": "A",
          "queryType": "stats",
          "expr": "app:resume event:=blog_view bot:=false kind:in(index, topic) | stats by (page) count() as views | sort by (views desc)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}
